{
  "_why": "Two implementations of one policy, run over one list. forge/src/series.js decides what may be recorded on Forge; scripts/serve_live.py decides it over loopback. Neither is arithmetic \u2014 the figures all come from agent/tools/metrics.py \u2014 but a policy that differed between transports would mean a sprint recorded down one route and reconstructed down the other, with the page saying different things about the same board depending on how it was reached. ADR 0009, ADR 0015. Cases carrying `seen` and `prior.issuesSeen` are ADR 0019: a row is a fact about the board, so a narrower view may not replace it and a wider one may correct it.",
  "recordable": [
    {
      "name": "an active sprint, never seen before",
      "state": "active",
      "prior": null,
      "record": true,
      "seen": null
    },
    {
      "name": "an active sprint we already have a mid-flight row for",
      "state": "active",
      "prior": {
        "final": false
      },
      "record": true,
      "seen": null
    },
    {
      "name": "a sprint we were watching, now closed",
      "state": "closed",
      "prior": {
        "final": false
      },
      "record": true,
      "seen": null
    },
    {
      "name": "a sprint that closed before we ever saw the board",
      "state": "closed",
      "prior": null,
      "record": false,
      "seen": null
    },
    {
      "name": "a sprint already recorded after its close",
      "state": "closed",
      "prior": {
        "final": true
      },
      "record": false,
      "seen": null
    },
    {
      "name": "an active sprint whose prior row is somehow already final",
      "state": "active",
      "prior": {
        "final": true
      },
      "record": false,
      "seen": null
    },
    {
      "name": "a state neither transport understands",
      "state": "future",
      "prior": null,
      "record": false,
      "seen": null
    },
    {
      "name": "no state at all",
      "state": null,
      "prior": null,
      "record": false,
      "seen": null
    },
    {
      "name": "a narrower view must not overwrite a board fact",
      "state": "closed",
      "prior": {
        "final": true,
        "issuesSeen": 40
      },
      "seen": 10,
      "record": false
    },
    {
      "name": "a wider view corrects a row a narrow reader recorded",
      "state": "closed",
      "prior": {
        "final": true,
        "issuesSeen": 10
      },
      "seen": 40,
      "record": true
    },
    {
      "name": "an equally wide view leaves a final row alone",
      "state": "closed",
      "prior": {
        "final": true,
        "issuesSeen": 40
      },
      "seen": 40,
      "record": false
    },
    {
      "name": "a narrower view is refused even on a running sprint",
      "state": "active",
      "prior": {
        "final": false,
        "issuesSeen": 40
      },
      "seen": 10,
      "record": false
    },
    {
      "name": "an unknown view width falls back to the old rule",
      "state": "closed",
      "prior": {
        "final": true,
        "issuesSeen": null
      },
      "seen": 40,
      "record": false
    }
  ],
