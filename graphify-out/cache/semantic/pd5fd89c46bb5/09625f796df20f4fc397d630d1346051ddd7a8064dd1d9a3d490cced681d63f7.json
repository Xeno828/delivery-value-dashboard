{"nodes": [{"id": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise", "label": "ADR 0017: A forecast is logged as a count by a date, not as a promise about these items", "file_type": "document", "source_file": "docs/adr/0017-a-forecast-is-logged-as-a-count-not-a-promise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise_forecast_log_capacity_claims", "label": "A published forecast is logged as capacity claims: count, date, probability", "file_type": "rationale", "source_file": "docs/adr/0017-a-forecast-is-logged-as-a-count-not-a-promise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sprint_completion ('all of it by the 14th') cannot be resolved without recording which items were outstanding, i.e. issue keys \u2014 refused because it puts customer-identifiable data in an app-level store and puts 4c on item 5's critical path. capacity_to_target resolves from a count of completions in a window, needs no identity, and yields four claims per forecast, reachable for calibration bucketing this decade."}, {"id": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise_deterministic_claim_id", "label": "A claim's id is deterministic: context, day, percentile", "file_type": "rationale", "source_file": "docs/adr/0017-a-forecast-is-logged-as-a-count-not-a-promise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Panel loads, the brief and a refreshing reader all produce the same forecast; without this the log holds one prediction eleven times and the Brier score looks excellent while measuring nothing."}, {"id": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise_refusal_not_a_claim", "label": "A refusal is not a claim", "file_type": "rationale", "source_file": "docs/adr/0017-a-forecast-is-logged-as-a-count-not-a-promise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recording a refusal as a prediction would score the forecaster on answers it explicitly refused to give, inverting the point of refusing."}, {"id": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise_claim_fields_allow_list", "label": "CLAIM_FIELDS allow-list; problems_in_claim refuses rather than trims", "file_type": "concept", "source_file": "docs/adr/0017-a-forecast-is-logged-as-a-count-not-a-promise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same shape as the series store, for the same reason: nothing identifying an issue or a person."}, {"id": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise_resolve_once_never_rescore", "label": "A claim is resolved once, over (madeOn, horizon], and never rescored", "file_type": "rationale", "source_file": "docs/adr/0017-a-forecast-is-logged-as-a-count-not-a-promise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recounting later against a board whose issues have moved would quietly change a published score; an item finished the morning of the forecast was history, not prediction. Limits stated: four claims per forecast are correlated so n is overstated; work moved off the board resolves false; below ten resolved entries score_calibration refuses."}], "edges": [{"source": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise", "target": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise_forecast_log_capacity_claims", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0017-a-forecast-is-logged-as-a-count-not-a-promise.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise", "target": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise_deterministic_claim_id", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0017-a-forecast-is-logged-as-a-count-not-a-promise.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise", "target": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise_refusal_not_a_claim", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0017-a-forecast-is-logged-as-a-count-not-a-promise.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise", "target": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise_claim_fields_allow_list", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0017-a-forecast-is-logged-as-a-count-not-a-promise.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise", "target": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise_resolve_once_never_rescore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0017-a-forecast-is-logged-as-a-count-not-a-promise.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise", "target": "docs_adr_0015_a_durable_series_stores_what_jira_forgets", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0017-a-forecast-is-logged-as-a-count-not-a-promise.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0015_a_durable_series_stores_what_jira_forgets_four_irrecoverables", "target": "docs_adr_0017_a_forecast_is_logged_as_a_count_not_a_promise_forecast_log_capacity_claims", "relation": "rationale_for", "confidence": "EXTRACTED", "