{"nodes": [{"id": "docs_adr_0022_sso_is_inherited_because_the_app_owns_no_identity", "label": "ADR 0022: SSO is inherited, because this app owns no identity", "file_type": "document", "source_file": "docs/adr/0022-sso-is-inherited-because-the-app-owns-no-identity.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0022_sso_is_inherited_because_the_app_owns_no_identity_sso_inherited_no_identity", "label": "SSO is inherited because the app owns no identity", "file_type": "rationale", "source_file": "docs/adr/0022-sso-is-inherited-because-the-app-owns-no-identity.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The panel is authenticated by Atlassian (context.accountId), the calculator authenticates callers not people, and the built file is a file with nobody to authenticate. Nothing to build \u2014 the same shape residency took under ADR 0012. Falsifiable claims are enforced by sso_checks() in tests/security.py. Not a claim of compliance, not a claim that authorisation (item 5) is solved."}, {"id": "docs_adr_0022_sso_is_inherited_because_the_app_owns_no_identity_no_atlassian_credential", "label": "No Atlassian credential, session or auth module in the app", "file_type": "rationale", "source_file": "docs/adr/0022-sso-is-inherited-because-the-app-owns-no-identity.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hard Marketplace requirement: an app holding a user's API token makes its REST activity indistinguishable from the customer's own and holds a credential no IdP can see. process.env appears in index.js once, in a comment; the check reads code not prose because an earlier suite failed on a comment (the dist-upgrade mistake)."}, {"id": "docs_adr_0022_sso_is_inherited_because_the_app_owns_no_identity_personal_token_path_in_scripts", "label": "The personal API token path lives only in scripts/", "file_type": "rationale", "source_file": "docs/adr/0022-sso-is-inherited-because-the-app-owns-no-identity.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "scripts/fetch_delivery_data.py can use JIRA_TOKEN, a credential no IdP stands in front of. It is an operator's tool on their own machine and the suite asserts it exists only in scripts/. If a supported route is ever chosen, OAuth (scripts/jira_auth.py) is the one to keep."}], "edges": [{"source": "docs_adr_0022_sso_is_inherited_because_the_app_owns_no_identity", "target": "docs_adr_0022_sso_is_inherited_because_the_app_owns_no_identity_sso_inherited_no_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0022-sso-is-inherited-because-the-app-owns-no-identity.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0022_sso_is_inherited_because_the_app_owns_no_identity", "target": "docs_adr_0022_sso_is_inherited_because_the_app_owns_no_identity_no_atlassian_credential", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0022-sso-is-inherited-because-the-app-owns-no-identity.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0022_sso_is_inherited_because_the_app_owns_no_identity", "target": "docs_adr_0022_sso_is_inherited_because_the_app_owns_no_identity_personal_token_path_in_scripts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0022-sso-is-inherited-because-the-app-owns-no-identity.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0022_sso_is_inherited_because_the_app_owns_no_identity", "target": "docs_adr_0001_single_self_contained_html_file", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0022-sso-is-inherited-because-the-app-owns-no