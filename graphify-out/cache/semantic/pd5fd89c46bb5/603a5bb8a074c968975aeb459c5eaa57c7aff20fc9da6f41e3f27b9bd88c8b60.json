{"nodes": [{"id": "docs_dashboard_review", "label": "Sprint 24 dashboard review", "file_type": "document", "source_file": "docs/dashboard-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_dashboard_review_one_completion_figure", "label": "One completion figure from a single field", "file_type": "rationale", "source_file": "docs/dashboard-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The original showed Done 13, Tasks Done 15/22 and Work Complete 9/22 at once; a reader who notices stops trusting every other number."}, {"id": "docs_dashboard_review_burndown_scope_line", "label": "Burndown with a scope line and mid-sprint callout", "file_type": "rationale", "source_file": "docs/dashboard-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separates 'this team is slow' from 'this team was given more work' \u2014 opposite conversations the original merged."}, {"id": "docs_dashboard_review_waiting_vs_working_chart", "label": "Waiting-vs-working elapsed time chart", "file_type": "rationale", "source_file": "docs/dashboard-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each closed item as one bar split into queue and active time; 22% active on the demo means 78% queueing, the largest and cheapest improvement, invisible when lead and cycle are two bars nobody subtracts."}, {"id": "docs_dashboard_review_team_load_card", "label": "Team load card replacing output-per-person and overtime", "file_type": "rationale", "source_file": "docs/dashboard-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The organisation does not operate overtime, so charting hours implied a regime that does not 