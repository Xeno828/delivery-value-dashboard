{"nodes": [{"id": "docs_adr_0007_refuse_rather_than_widen", "label": "ADR 0007: Below the evidence thresholds, refuse rather than widen the interval", "file_type": "document", "source_file": "docs/adr/0007-refuse-rather-than-widen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0007_refuse_rather_than_widen_refuse_rather_than_widen", "label": "Refuse rather than widen the interval", "file_type": "rationale", "source_file": "docs/adr/0007-refuse-rather-than-widen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A wide interval says 'we know this is variable'; a refusal says 'we do not know this at all'. Below the threshold only the refusal is true, and the wide interval is more dangerous because it still carries a quotable number. Thresholds are hard, not advisory."}, {"id": "docs_adr_0007_refuse_rather_than_widen_evidence_absent_not_noisy", "label": "Refusal clause: the evidence is absent, not noisy", "file_type": "concept", "source_file": "docs/adr/0007-refuse-rather-than-widen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every refusal sentence ends with this clause; it is the point of the refusal and must not be trimmed. Refusals are printed verbatim by the agent, never softened."}], "edges": [{"source": "docs_adr_0007_refuse_rather_than_widen", "target": "docs_adr_0007_refuse_rather_than_widen_refuse_rather_than_widen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0007-refuse-rather-than-widen.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0007_refuse_rather_than_widen", "target": "docs_adr_0007_refuse_rather_than_widen_evidence_absent_not_noisy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0007-refuse-ra