{"nodes": [{"id": "context_issue", "label": "Issue", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row of tracker data, the atomic unit. Avoid ticket, card, task."}, {"id": "context_item", "label": "Item", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An issue counted as one regardless of size; the only unit a forecast uses."}, {"id": "context_point", "label": "Point", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Story-point estimate; a display lens, never a forecasting input."}, {"id": "context_epic", "label": "Epic", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parent grouping; the sample unit for sizing an ask once nearly complete, and an ask itself when declared a candidate."}, {"id": "context_board", "label": "Board", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The delivery unit a forecast is scoped to; throughput, interruption rate and t-shirt scale never transfer between boards. Exactly two kinds."}, {"id": "context_sprint_board", "label": "Sprint board", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only board kind with a committed scope and a clock, hence the only one with a burndown, pace and sprint health."}, {"id": "context_flow_board", "label": "Flow board", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs no sprints; detected rather than declared because Jira answers 400 for its sprint list."}, {"id": "context_sprint", "label": "Sprint", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both a bound and a clock: fixed scope with a start and end delivery is measured against."}, {"id": "context_window", "label": "Window", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rolling stretch of calendar days on a flow board; a bound and not a clock, carrying no working-day list because a team that committed to nothing cannot be behind."}, {"id": "context_period", "label": "Period", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whichever of sprint or window a context is bounded by; the word for sentences true of both."}, {"id": "context_selected_context", "label": "Context (selected)", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One project + board + period; its kind is sent rather than inferred from the id shape."}, {"id": "context_bundle", "label": "Bundle", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Several contexts and their issues in one file, fetched up front so switching is instant and offline."}, {"id": "context_live_mode", "label": "Live mode", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An optional local server the page discovers to pull contexts the bundle lacks; not a connection to the tracker."}, {"id": "context_elapsed_time", "label": "Elapsed time", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Time as a stakeholder experiences it, always calendar days."}, {"id": "context_simulated_time", "label": "Simulated time", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Time inside a forecast, always working days; never reported without its unit."}, {"id": "context_lead_time", "label": "Lead time", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Created to resolved, the whole wait."}, {"id": "context_cycle_time", "label": "Cycle time", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Started to resolved, the part actively worked."}, {"id": "context_waiting", "label": "Waiting", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lead time minus cycle time; most of the total on typical data and the cheapest thing to fix."}, {"id": "context_flow_efficiency", "label": "Flow efficiency", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Total cycle over total lead time across completed issues; 40% is the one threshold."}, {"id": "context_ageing", "label": "Ageing", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How long an open issue has been alive, in calendar days."}, {"id": "context_throughput", "label": "Throughput", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Items completed per working day sampled across a trailing window; zero days are part of the distribution. Shown per calendar week as a series."}, {"id": "context_cycle_time_percentile", "label": "Cycle time percentile", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What 50/85/95% of finished items came in under; the 85th is quoted outward as a statement about the system, never one item."}, {"id": "context_cumulative_flow", "label": "Cumulative flow", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Items per status category per day, three bands because nothing records which column an issue sat in."}, {"id": "context_work_in_progress", "label": "Work in progress", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Started but unfinished at period end; half of team load, from status alone."}, {"id": "context_unplanned_work", "label": "Unplanned work", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Items that arrived after planning; the other half of team load."}, {"id": "context_scope_growth", "label": "Scope growth", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Work added after a sprint began, plotted as its own line so 'given more' stays distinct from 'slow'."}, {"id": "context_interruption_rate", "label": "Interruption rate", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unplanned share of all work taken on, per board, used to thin the throughput series in a forecast."}, {"id": "context_facts_pack", "label": "Facts pack", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The complete set of figures a report may state, computed once and quoted verbatim."}, {"id": "context_snapshot", "label": "Snapshot", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A facts pack stored with its date so a later report can say what changed."}, {"id": "context_diff", "label": "Diff", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The change between two snapshots with the direction that counts as good stated per figure."}, {"id": "context_durable_series", "label": "Durable series", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-sprint rows recorded when each sprint closed, with observation time and status configuration. Not a cache; Jira stays authoritative. ADR 0015."}, {"id": "context_recorded_row", "label": "Recorded row", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A sprint's row written when it closed, when every figure was still observable."}, {"id": "context_reconstructed_row", "label": "Reconstructed row", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-derived after the fact for a sprint that closed before the app existed; a row with a different warrant, not a worse one."}, {"id": "context_health_score", "label": "Health score", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A weighted band that always shows its working; two of them, one per board kind, never the same quantity."}, {"id": "context_sprint_health", "label": "Sprint health", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delivery pace, scope stability, blockers, ageing; two need a clock so it is replaced on a flow board."}, {"id": "context_flow_health", "label": "Flow health", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flow efficiency at 40% weight, blockers and ageing at 30% each; refuses outright without flow efficiency because the remainder is hygiene."}, {"id": "context_risk_register", "label": "Risk register", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Risks computed from the data on screen including the active filter, never typed by hand."}, {"id": "context_drill_down", "label": "Drill-down", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The panel behind every figure listing the issues that produced it; what makes a number checkable."}, {"id": "context_value_basis", "label": "Value basis", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The stated justification attached to a value figure; a value without a basis is not reported."}, {"id": "context_forecast", "label": "Forecast", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A set of dated percentiles from simulating throughput against remaining work; never a single date."}, {"id": "context_refusal", "label": "Refusal", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The answer when evidence falls below a threshold, stating what was needed and what was there; quoted word for word."}, {"id": "context_size_stability", "label": "Size stability", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whether items are still interchangeable enough for counting to mean anything."}, {"id": "context_calibration", "label": "Calibration", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How past published forecasts scored against outcomes; without it a forecaster is unfalsifiable."}, {"id": "context_commitment_recommendation", "label": "Commitment recommendation", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Next-sprint item count from recent throughput; an input to a conversation. Refuses on a flow board for want of a cadence."}, {"id": "context_ask", "label": "Ask", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A product request being weighed against others; a document in data/asks/ or an epic marked candidate. Declared, not inferred from tickets."}, {"id": "context_candidate", "label": "Candidate", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An issue somebody declared under consideration; a state, not a type, untrue only when the declarer takes it back. ADR 0028."}, {"id": "context_sizing_method", "label": "Sizing method", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "t-shirt, reference class or explicit; recorded with every forecast because it bounds trust."}, {"id": "context_t_shirt_scale", "label": "T-shirt scale", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "S/M/L/XL bands from one board's own completed epics in items; never organisation-wide."}, {"id": "context_band", "label": "Band", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The S/M/L/XL on an epic; selects a quartile of the board's completed epics and asserts no number. ADR 0029."}, {"id": "context_reference_class", "label": "Reference class", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The board's completed epics used as the sample; whole class with no band, one quartile with one."}, {"id": "context_readiness", "label": "Readiness", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whether an ask carries enough to forecast at all, and which gaps widen the answer."}, {"id": "context_queue_ahead", "label": "Queue ahead", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Committed unfinished work an ask waits behind, excluding mid-sprint additions already modelled as interruption."}, {"id": "context_capacity_scenario", "label": "Capacity scenario", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exactly two, always together: earliest possible (a ceiling) and realistic (queued and interrupted)."}, {"id": "context_cost_of_the_queue", "label": "Cost of the queue", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gap between the two scenarios in working days; the figure to quote because it prices what is in flight."}, {"id": "context_uncertainty_attribution", "label": "Uncertainty attribution", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Split of spread between not knowing the size and normal delivery variability; says which is worth reducing."}, {"id": "context_sequence", "label": "Sequence", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An ordering of asks reported by what each costs the others; the ordering itself stays a human judgement, no priority score."}, {"id": "context_calculator", "label": "Calculator", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The hosted service that ran agent/tools/ unchanged for the Forge app; retired by ADR 0031, after which the same Python runs inside the Forge function."}], "edges": [{"source": "context_waiting", "target": "context_lead_time", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CONTEXT.md", "source_location": null, "weight": 1.0}, {"source": "context_waiting", "target": "context_cycle_time", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CONTEXT.md", "source_location": null, "weight": 1.0}, {"source": "context_flow_efficiency", "target": "context_cycle_time", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CONTEXT.md", "source_location": null, "weight": 1.0}, {"source": "context_flow_efficiency", "target": "context_lead_time", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CONTEXT.md", "source_location": null, "weight": 1.0}, {"source": "context_flow_efficiency", "target": "context_flow_health", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CONTEXT.md", "source_location": null, "weight": 1.0}, {"source": "context_sprint_board", "target": "context_board", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CONTEXT.md", "source_location": null, "weight": 1.0}, {"source": "context_flow_board", 