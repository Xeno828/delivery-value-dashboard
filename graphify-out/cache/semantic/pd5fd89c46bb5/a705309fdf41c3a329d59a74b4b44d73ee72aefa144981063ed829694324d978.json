 "confidence_score": 1.0, "source_file": "docs/forecasting-agent.md", "source_location": null, "weight": 1.0}, {"source": "docs_forecasting_agent_tools_compute_agent_narrates", "target": "agent_tools_forecast", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/forecasting-agent.md", "source_location": null, "weight": 1.0}, {"source": "docs_forecasting_agent_recommend_commitment_85", "target": "agent_tools_forecast_recommend_commitment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/forecasting-agent.md", "source_location": null, "weight": 1.0}, {"source": "docs_forecasting_agent_size_stability_guard", "target": "agent_tools_forecast_size_stability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/forecasting-agent.md", "source_location": null, "weight": 1.0}, {"source": "docs_forecasting_agent_intake_sizing_ladder", "target": "agent_tools_intake_size_ask", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/forecasting-agent.md", "source_location": null, "weight": 1.0}, {"source": "docs_forecasting_agent_intake_sizing_ladder", "target": "agent_tools_intake_readiness", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/forecasting-agent.md", "source_location": null, "weight": 1.0}, {"source": "docs_forecasting_agent_sequencing_consequences_not_score", "target": "agent_tools_intake_sequence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/forecasting-agent.md", "source_location": null, "weight": 1.0}, {"source": "docs_forecasting_agent", "target": "agent_tools_intake_board_issues", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/forecasting-agent.md", "source_location": null, "weight": 1.0}, {"source": "docs_forecasting_age