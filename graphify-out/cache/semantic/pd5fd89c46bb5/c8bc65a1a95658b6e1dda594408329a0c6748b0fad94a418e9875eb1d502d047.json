{"nodes": [{"id": "readme_delivery_value_dashboard", "label": "Delivery Value Dashboard", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single self-contained HTML file turning Jira or Asana data into a report an executive can read and an engineer can interrogate; every number clicks through to its issues. Chosen over PowerPoint (a snapshot) and BI tools (licences, pipeline, owner) as the right rung until metrics prove used."}, {"id": "readme_four_questions", "label": "The four questions activity reporting fails to answer", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Are we behind or were we given more; where does the time go; is the commitment realistic; what is any of it worth."}, {"id": "readme_monte_carlo_forecast_tile", "label": "Monte Carlo forecast tile", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers when and how-many for the selected context by calling forecast.py over the live connection, not reimplemented in the page; samples the team's whole history and takes only the outstanding count from the selected sprint. Shows an offline notice in an emailed copy."}, {"id": "readme_sequence_asks_mode", "label": "Sequence asks tile mode", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs intake.py --sequence for the board; leads with asks that miss their date in every ordering, names asks it could not size, computes no value score."}, {"id": "readme_tile_presets", "label": "Executive and Team tile presets", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shaped after agent/templates/exec-brief.md and team-report.md so a printed view and the agent's brief for one audience do not disagree about what matters; both keep the narrative tile."}, {"id": "readme_save_view_as_file", "label": "Save this view as a file", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes a standalone HTML copy with the view and the currently loaded data baked in; the one to email. Views also travel by print and by ?view= / ?tiles= / ?order= URL."}, {"id": "readme_tile_ordering", "label": "Tile ordering with arrow buttons", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arrows move the tile itself rather than a CSS order so tab and reading order follow the picture; keyboard-operable where drag and drop would not be."}, {"id": "readme_data_routes", "label": "Three routes for getting data in", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upload a file (works immediately), the fetcher script (regular refreshes, OAuth or token), MCP connectors (once the format has proved itself)."}], "edges": [{"source": "readme_delivery_value_dashboard", "target": "readme_four_questions", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_monte_carlo_forecast_tile", "target": "agent_tools_forecast", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_monte_carl