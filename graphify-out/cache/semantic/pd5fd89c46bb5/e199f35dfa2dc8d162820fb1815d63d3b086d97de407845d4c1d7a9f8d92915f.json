{"nodes": [{"id": "docs_adr_0003_the_dashboard_does_not_measure_people", "label": "ADR 0003: The dashboard does not measure people", "file_type": "document", "source_file": "docs/adr/0003-the-dashboard-does-not-measure-people.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0003_the_dashboard_does_not_measure_people_no_people_measurement", "label": "No hours, overtime, timesheet field; no ranking of individuals", "file_type": "rationale", "source_file": "docs/adr/0003-the-dashboard-does-not-measure-people.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A time-tracking field implies a regime the organisation does not operate and invites someone to fill it in; individual throughput comparison is a claim the data cannot support because throughput is a property of the system. An earlier version charted output-per-person against overtime and both were removed."}, {"id": "docs_adr_0003_the_dashboard_does_not_measure_people_team_load", "label": "Team load: WIP and unplanned work from issue status", "file_type": "concept", "source_file": "docs/adr/0003-the-dashboard-does-not-measure-people.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The replacement metric: derived from issue status alone, so no effort data is needed. If a metric appears to need effort data it is the wrong metric."}], "edges": [{"source": "docs_adr_0003_the_dashboard_does_not_measure_people", "target": "docs_adr_0003_the_dashboard_does_not_measure_people_no_people_measurement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0003-the-dashboard-does-not-measure-people.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0003_the_dashboard_does_not_measure_people", "target": "docs_adr_0003_the_dashboard_does_not_measure_people_team_load", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0003-the-dashboard-does-not-measure-people.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0003_the_dashboard_does_not_measure_people_no_people_measurement", "target": "docs_adr_0003_the_dashboard_does_not_measure_people_team_load", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0003-the-dashboard-does-not-measure-people.md", "source_location": null, "weight": 1.0}], "hyperedges": []}