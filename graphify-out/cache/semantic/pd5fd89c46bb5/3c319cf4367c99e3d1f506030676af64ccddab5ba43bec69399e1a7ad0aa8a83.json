{"nodes": [{"id": "docs_adr_0023_a_cross_team_rollup_spans_what_the_reader_can_see", "label": "ADR 0023 Cross-team roll-up spans what the reader can see", "file_type": "document", "source_file": "docs/adr/0023-a-cross-team-rollup-spans-what-the-reader-can-see.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0023_a_cross_team_rollup_spans_what_the_reader_can_see_cross_team_rollup", "label": "Cross-team roll-up", "file_type": "rationale", "source_file": "docs/adr/0023-a-cross-team-rollup-spans-what-the-reader-can-see.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spans the boards this reader can see and names them, because the app reads the board list as the viewer and cannot know which boards it is not seeing; a count cannot be checked, three names can. Windows excluded because 14/30/90-day windows overlap."}, {"id": "docs_adr_0023_a_cross_team_rollup_spans_what_the_reader_can_see_rollup_does_not_forecast", "label": "Cross-team roll-up refuses to forecast", "file_type": "rationale", "source_file": "docs/adr/0023-a-cross-team-rollup-spans-what-the-reader-can-see.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "team_slice selects by team label and would forecast one team under a cross-team heading (the 1.8.0 19-day-read-77 failure); pooling teams assumes interchangeable throughput, which nothing establishes."}, {"id": "docs_adr_0023_a_cross_team_rollup_spans_what_the_reader_can_see_what_an_ask_is_inside_jira", "label": "What an ask is inside Jira (open product question)", "file_type": "concept", "source_file": "docs/adr/0023-a-cross-team-rollup-spans-what-the-reader-can-see.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sequencing was never blocked on roadmap items 4 or 5 but on nobody deciding which Jira issue is an ask; ADR 0027 answered the value-basis half, the ask itself stayed open until 0028."}], "edges": [{"source": "docs_adr_0023_a_cross_team_rollup_spans_what_the_reader_can_see", "target": "docs_adr_0023_a_cross_team_rollup_spans_what_the_reader_can_see_cross_team_rollup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0023-a-cross-team-rollup-spans-what-the-reader-can-see.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0023_a_cross_team_rollup_spans_what_the_reader_can_see", "target": "docs_adr_0023_a_cross_team_rollup_spans_what_the_reader_can_see_rollup_does_not_forecast", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0023-a-cross-team-rollup-spans-what-the-reader-can-see.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0023_a_cross_team_rollup_spans_what_the_reader_can_see", "target": "docs_adr_0023_a_cross_team_rollup_spans_what_the_reader_can_see_what_an_ask_is_inside_jira", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0023-a-cross-team-rollup-spans-what-the-reader-can-see.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0023_a_cross_team_rollup_spans_what_the_reader_can_see", "target": "docs_adr_0018_permission_mirroring_holds_by_accident_and_where_it_does_not", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0023-a-cross-team-rollup-spans-what-the-reader-can-see.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0023_a_cross_team_rollup_spans_what_the_reader_can_see", "target": "docs_adr_0027_a_value_basis_is_prose_carried_to_a_reader", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0023-a-cross-team-rollup-spans-what-the-reader-can-see.md", "source_location": null, "weight": 1.0},