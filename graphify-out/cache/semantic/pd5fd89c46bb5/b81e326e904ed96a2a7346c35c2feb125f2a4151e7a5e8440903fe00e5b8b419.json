{"nodes": [{"id": "claude", "label": "CLAUDE.md working constraints", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_architecture", "label": "Architecture in one paragraph", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "src/ four files built by build.py; agent/tools/ five modules; service/routes.py answer(path, body) runs unchanged under WebAssembly in the Forge function; no remote since 2026-09-03."}, {"id": "claude_dist_committed", "label": "dist/ is committed on purpose", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repository usable without a build step; CI fails if stale."}, {"id": "claude_no_hours_or_overtime_field", "label": "No hours, overtime, or timesheet field", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Organisation does not operate overtime; such a field implies a time-tracking regime; load measured as WIP and unplanned work."}, {"id": "claude_never_rank_individuals", "label": "Never rank or compare individuals", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Throughput is a property of the system; the data cannot support the claim."}, {"id": "claude_never_compute_priority_score", "label": "Never compute a priority score", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WSJF multiplies unvalidated estimates; value basis is free text so it cannot become a weight."}, {"id": "claude_nothing_between_tools_and_reader_does_arithmetic", "label": "Nothing between the tools and a reader may do arithmetic", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "routes.py and the Forge resolver validate, delegate and pass through; test_service and test_wasm assert byte equality."}, {"id": "claude_agent_never_does_arithmetic", "label": "The agent never does arithmetic", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every figure comes from a tool so the report is auditable."}, {"id": "claude_one_contract_two_transports", "label": "Live mode has two transports and one set of body shapes", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bodies are the contract; src/app.js never learns which transport it has."}, {"id": "claude_zero_network_zero_storage", "label": "Built file makes zero network calls and uses zero browser storage", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Threat model: the file gets emailed."}, {"id": "claude_credentials_only_in_fetcher_environment", "label": "Credentials live only in the fetcher's environment", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".env, .jira-oauth.json and data/dashboard-data.json are git-ignored; loopback-only listeners; read-only OAuth scopes."}, {"id": "claude_read_only_scopes_allow_list", "label": "Every Forge scope is read-only except two named ones", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "send:notification:jira and storage:app are allow-listed with justification in the manifest; stricter than a prefix check."}, {"id": "claude_major_version_rule", "label": "New module type or scope change is major; another entry under a declared block is not", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Check by deploying; the window is free until the first external install; removing a remote with realms was major on 2026-09-03."}, {"id": "claude_manifest_declares_no_remote", "label": "The manifest declares no remote and must not gain one", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A remote added after the first external install is a major version, a reinstall for every tenant and the Runs on Atlassian badge gone; test_service asserts no remotes block, egress permission or Cloud Run hostname under forge/."}, {"id": "claude_refusals_printed_verbatim", "label": "Refusals are printed verbatim, never softened", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Not enough data' and 'wide interval' are different statements; the closing clause 'the evidence is absent, not noisy' is the point."}, {"id": "claude_empty_selection_is_a_refusal", "label": "An empty selection is a refusal, not a zero", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shares over zero issues have no denominator; composites drop and name unmeasured components, refuse below half weight, and say which cause."}, {"id": "claude_org_config_travels_inside_data", "label": "The organisation config travels inside the data, never beside it", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolved once by the producer as orgConfig; app.js mirrors orgconfig.py and e2e asserts agreement under a non-default config; on Forge the resolver resolves from Jira status categories plus a project property."}, {"id": "claude_every_figure_carries_its_unit", "label": "Every figure carries its unit", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reported elapsed time in calendar days, simulated time in working days; the 25%/22% flow efficiency disagreement shipped once."}, {"id": "claude_value_counted_at_one_level", "label": "Business value counted at one hierarchy level", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "valueFromHierarchy defaults to 1; orgconfig.value_of() is the only reader; issues with no level still count."}, {"id": "claude_parent_and_subtasks_one_item", "label": "A parent and its subtasks are one item", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "countSubtasks defaults false; counted_issues() and countedIssues() mirror each other."}, {"id": "claude_forecasts_in_items_not_points", "label": "Forecasts are in items, never story points", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six point-observations cannot support a distribution; items cannot be inflated by estimating generously."}, {"id": "claude_monte_carlo_seeded", "label": "Monte Carlo is seeded and reproducible", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed SEED, 20,000 trials; a forecast that moves when nothing changed is not a forecast."}, {"id": "claude_zero_throughput_days_stay", "label": "Zero-throughput days stay in the sample", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dropping them is the most common way a Monte Carlo turns optimistic."}, {"id": "claude_refusal_thresholds_hard", "label": "Refusal thresholds are hard, not advisory", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Below them the honest answer is not enough data, not a wider interval."}, {"id": "claude_no_silent_caps", "label": "No silent caps", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any bound on output must say what was dropped; bitten by a readiness printer and an overlapping backtest."}, {"id": "claude_ui_tokens_separate_from_palette", "label": "UI colour tokens are separate from the chart palette", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contrast fixes must never touch series colours validated for colour-vision deficiency."}, {"id": "claude_escape_at_output_once", "label": "Escape at output, once", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "s