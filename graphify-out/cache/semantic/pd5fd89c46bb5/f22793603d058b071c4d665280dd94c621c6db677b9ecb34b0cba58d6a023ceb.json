{"nodes": [{"id": "docs_research_2026_09_01_forge_async_events_research_note", "label": "Research note: async events for sequencing (2026-09-01)", "file_type": "document", "source_file": "docs/research/2026-09-01-forge-async-events.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Can a Custom UI resolver with a 25 s budget hand a ~170 s sequencing job to an async event and collect it later? Every claim labelled documented or not established; no experiment run."}, {"id": "docs_research_2026_09_01_forge_async_events_consumer_module", "label": "Forge consumer module", "file_type": "concept", "source_file": "docs/research/2026-09-01-forge-async-events.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "modules.consumer[] with key, queue, function, optional crossVersion; the named function carries its own timeoutSeconds and memoryMB. Queue name in the manifest is the one passed to new Queue({key})."}, {"id": "docs_research_2026_09_01_forge_async_events_major_version_list", "label": "Documented major-version change list", "file_type": "concept", "source_file": "docs/research/2026-09-01-forge-async-events.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scopes, CSP options, external URLs, dynamic web triggers, egress categories, inScopeEUD, licensing, providers, remotes, customer-managed egress; everything else minor. Not presented as exhaustive; the repository saw jira:customField go major, so the CLI on deploy is the arbiter."}, {"id": "docs_research_2026_09_01_forge_async_events_consumer_limits", "label": "Consumer function limits: 900 s, 1,024 MB", "file_type": "concept", "source_file": "docs/research/2026-09-01-forge-async-events.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "timeoutSeconds 1-900 applies to scheduled triggers and async consumers only, default 55 s; memory 512 MB default, 1,024 MB max, per function. Billing is measured time, so a smaller timeout bounds a hung run."}, {"id": "docs_research_2026_09_01_forge_async_events_async_event_retries", "label": "Async event at-least-once delivery and retries", "file_type": "concept", "source_file": "docs/research/2026-09-01-forge-async-events.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "200 KB per push (100 KB per event above 55 s timeout), 50 events per push, 500 per minute; a timeout is an app-level error retried within a 24 h retention window with exponential backoff; retryContext carries retryCount, retryReason, retryData, retentionWindow."}, {"id": "docs_research_2026_09_01_forge_async_events_job_status_and_cancel", "label": "Job status is counts only; cancel exists", "file_type": "concept", "source_file": "docs/research/2026-09-01-forge-async-events.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "push returns jobId; getJob(jobId).cancel() and getStats() returning {success, inProgress, failed} are the whole documented status, so the result itself must be written to storage; delayInSeconds up to 15 minutes."}, {"id": "docs_research_2026_09_01_forge_async_events_kvs_storage_for_result", "label": "KVS as the result store for a poller", "file_type": "concept", "source_file": "docs/research/2026-09-01-forge-async-events.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "storage:app already declared; 240 KiB per value, 500-char keys, 4,000 reads and writes per minute per installation, TTL up to a year, kvs.get strictly consistent. No index or query needed since the page knows the jobId."}, {"id": "docs_research_2026_09_01_forge_async_events_resolver_returns_early", "label": "A resolver returns before its pushed work completes", "file_type": "rationale", "source_file": "docs/research/2026-09-01-forge-async-events.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Realtime tutorial's resolver awaits only queue.push and returns; the consumer runs under its own 900 s. No bridge invoke timeout is documented separately from the 25 s function limit."}, {"id": "docs_research_2026_09_01_forge_async_events_forge_realtime", "label": "Forge Realtime as an alternative to polling", "file_type": "concept", "source_file": "docs/research/2026-09-01-forge-async-events.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GA, 50 ops/s per installation, no scope; from a consumer only subscribeGlobal/publishGlobal work and a page that navigated away misses the answer unless it is also in storage."}], "edges": [{"source": "docs_research_2026_09_01_forge_async_events_research_note", "target": "docs_research_2026_09_01_forge_async_events_consumer_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/2026-09-01-forge-async-events.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_2026_09_01_forge_async_events_consumer_module", "target": "docs_research_2026_09_01_forge_async_events_major_version_list", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/2026-09-01-forge-async-events.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_2026_09_01_forge_async_events_consumer_module", "target": "docs_research_2026_09_01_forge_async_events_consumer_limits", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/2026-09-01-forge-async-events.md", "source_location": null, "weight": 1.0}, {"so