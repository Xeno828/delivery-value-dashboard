{"nodes": [{"id": "docs_adr_0008_forge_calls_a_hosted_calculator", "label": "ADR 0008: If we ship on Forge, Forge calls a hosted calculator", "file_type": "document", "source_file": "docs/adr/0008-forge-calls-a-hosted-calculator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0008_forge_calls_a_hosted_calculator_hosted_calculator", "label": "Hosted calculator imports the Python tools unchanged", "file_type": "rationale", "source_file": "docs/adr/0008-forge-calls-a-hosted-calculator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forge runs Node and cannot execute agent/tools/. Porting the Monte Carlo to JavaScript is a second implementation (which ADR 0005 forbids) and dropping the forecast sells a delivery product without its forecast. Three measurements decided it: the tools are pure functions; a call is ~16 KB and does not grow with the customer; a dataset stripped of titles produces byte-identical figures, so no issue title leaves Atlassian."}, {"id": "docs_adr_0008_forge_calls_a_hosted_calculator_runs_on_atlassian_badge", "label": "Runs on Atlassian badge", "file_type": "concept", "source_file": "docs/adr/0008-forge-calls-a-hosted-calculator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Egress disqualifies the app from the badge; forge eligibility reports it as two findings (remote services, egressing data). Originally described as 'the badge or a second implementation, nothing in between' \u2014 corrected by the 2026-09-01 amendment."}, {"id": "docs_adr_0008_forge_calls_a_hosted_calculator_pyodide_in_function", "label": "Pyodide (CPython under WebAssembly) inside the Forge function", "file_type": "rationale", "source_file": "docs/adr/0008-forge-calls-a-hosted-calculator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The third shape not considered originally: the existing Python unchanged under Pyodide inside the Forge function. Measured 2026-09-01: byte-identical figures to native CPython, no egress, ~10x slower, 6.8s cold load, IN.sequence 13.6s warm / 21s cold against a 25s resolver timeout. Decided later the same day in ADR 0031: the in-function route is taken and the calculator retired."}, {"id": "docs_adr_0008_forge_calls_a_hosted_calculator_csp_inline_style_workaround", "label": "Forge CSP forbids inline style/script; split build and CSSOM setter wrap", "file_type": "rationale", "source_file": "docs/adr/0008-forge-calls-a-hosted-calculator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Forge Custom UI iframe blocks inline <style>, <script> and style= attributes silently. build.py --split emits the same sources as linked assets (one assembly declining to inline, not a second implementation). Relaxing the CSP via permissions.content.styles unsafe-inline was rejected; removing style= attributes was rejected because it would make the single file's layout depend on JavaScript. src/app.js feature-detects the discarded attribute and wraps the innerHTML setter once, because a missed call site is a tile that silently loses its colour."}, {"id": "docs_adr_0008_forge_calls_a_hosted_calculator_pyodide_in_iframe_rejected", "label": "Pyodide in the Custom UI iframe (rejected)", "file_type": "rationale", "source_file": "docs/adr/0008-forge-calls-a-hosted-calculator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs unsafe-eval in permissions.content.scripts, a major version carrying the September deadline; a hidden tab ran at less than half speed; and the weekly brief has no browser to run in."}], "edges": [{"source": "docs_adr_0008_forge_calls_a_hosted_calculator", "target": "docs_adr_0008_forge_calls_a_hosted_calculator_hosted_calculator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-forge-calls-a-hosted-calculator.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0008_forge_calls_a_hosted_calculator", "target": "docs_adr_0008_forge_calls_a_hosted_calculator_runs_on_atlassian_badge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-forge-calls-a-hosted-calculator.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0008_forge_calls_a_hosted_calculator", "target": "docs_adr_0008_forge_calls_a_hosted_calculator_pyodide_in_function", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-forge-calls-a-hosted-calculator.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0008_forge_calls_a_hosted_calculator", "target": "docs_adr_0008_forge_calls_a_hosted_calculator_csp_inline_style_workaround", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-forge-calls-a-hosted-calculator.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0008_forge_calls_a_hosted_calculator", "target": "docs_adr_0008_forge_calls_a_hosted_calculator_pyodide_in_iframe_rejected", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-forge-calls-a-hosted-calculator.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0008_forge_calls_a_hosted_calculator", "target": "docs_adr_0005_tools_compute_the_agent_narrates", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-forge-calls-a-hosted-calculator.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0008_forge_calls_a_hosted_calculator", "target": "docs_adr_0001_single_self_contained_html_file", "relation": "