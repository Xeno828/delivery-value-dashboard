{"nodes": [{"id": "docs_adr_0002_bundle_not_live_query", "label": "ADR 0002: The page never queries Jira or Asana; data arrives as a bundle", "file_type": "document", "source_file": "docs/adr/0002-bundle-not-live-query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0002_bundle_not_live_query_bundled_contexts", "label": "Contexts fetched up front into a bundle", "file_type": "rationale", "source_file": "docs/adr/0002-bundle-not-live-query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A static HTML file has no MCP client, both tracker APIs reject cross-origin browser requests, and any embedded credential is readable by every recipient; bundling makes switching instant, offline and emailable. Proxying through a hosted service was rejected because it reintroduces the credential and infrastructure the single-file decision avoids."}, {"id": "docs_adr_0002_bundle_not_live_query_live_mode", "label": "Live mode: local server on 127.0.0.1", "file_type": "rationale", "source_file": "docs/adr/0002-bundle-not-live-query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The deliberate escape hatch: a local server the user starts on purpose that the page discovers and pulls unbundled contexts from; degrades in one direction only."}], "edges": [{"source": "docs_adr_0002_bundle_not_live_query", "target": "docs_adr_0002_bundle_not_live_query_bundled_contexts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-bundle-not-live-query.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0002_bundle_not_live_query", "target": "docs_adr_0002_bundle_not_live_query_live_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-bundle-not-live-query.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0002_bundle_not_live_query_live_mode", "target": "scripts_serve_live", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-bundle-not-live-query.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0002_bundle_not_live_query_bundled_contexts", "target": "docs_adr_0001_single_self_contained_html_file_single_file_dashboard", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/adr/0002-bundle-not-live-query.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0002_bundle_not_live_query", "target": "docs_contexts_and_live_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-bundle-not-live-query.md", "source_location": null, "weight": 1.0}], "hyperedges": []}