, "weight": 1.0}, {"source": "docs_roadmap_item_3_scheduled_delivery", "target": "docs_roadmap_item_5_permission_mirroring", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/roadmap.md", "source_location": null, "weight": 1.0}, {"source": "docs_roadmap_item_3_scheduled_delivery", "target": "forge_manifest_llm_brief_writer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/roadmap.md", "source_location": null, "weight": 1.0}, {"source": "docs_roadmap_item_3_scheduled_delivery", "target": "forge_manifest_send_notification_scope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/roadmap.md", "source_location": null, "weight": 1.0}, {"source": "docs_roadmap_item_4_durable_sprint_history", "target": "docs_roadmap_forecast_log", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/roadmap.md", "source_location": null, "weight": 1.0}, {"source": "docs_roadmap_item_4_durable_sprint_history", "target": "docs_roadmap_item_5_permission_mirroring", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/roadmap.md", "source_location": null, "weight": 1.0}, {"source": "docs_roadmap_item_4_durable_sprint_history", "target": "forge_src_series", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/roadmap.md", "source_location": null, "weight": 1.0}, {"source": "docs_roadmap_item_4_durable_sprint_history", "target": "agent_tools_forecast_score_calibration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/roadmap.md", "source_location": null, "weight": 1.0}, {"source": "docs_roadmap_item_6_sso_audit_residency", "target": "docs_roadmap_activity_log", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/roadma