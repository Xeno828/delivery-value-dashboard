{"nodes": [{"id": "docs_adr_0012_the_calculator_is_reached_by_invokeremote", "label": "ADR 0012 \u2014 The calculator is reached by invokeRemote (superseded)", "file_type": "document", "source_file": "docs/adr/0012-the-calculator-is-reached-by-invokeremote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Superseded 2026-09-03 by ADR 0031; kept because the reasoning about tokens, residency and operations: [compute] is what a future remote would have to satisfy again."}, {"id": "docs_adr_0012_the_calculator_is_reached_by_invokeremote_invokeremote", "label": "invokeRemote() from @forge/api", "file_type": "rationale", "source_file": "docs/adr/0012-the-calculator-is-reached-by-invokeremote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atlassian attaches an invocation token; the service verifies it against Atlassian's JWKS and binds installation identity from app.installationId; no secret of its own."}, {"id": "docs_adr_0012_the_calculator_is_reached_by_invokeremote_region_pinning", "label": "Region pinning resolved by Forge per install", "file_type": "rationale", "source_file": "docs/adr/0012-the-calculator-is-reached-by-invokeremote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fetch(process.env.CALCULATOR_URL) is one URL for every installation; an app that builds its own URL cannot take part in residency routing and would need to identify tenants itself."}, {"id": "docs_adr_0012_the_calculator_is_reached_by_invokeremote_slice_route", "label": "/v1/slice asks which contexts to sample", "file_type": "rationale", "source_file": "docs/adr/0012-the-calculator-is-reached-by-invokeremote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "team_slice has been got wrong twice, each time returning a plausible date; the resolver asks the calculator rather than deciding the slice itself."}, {"id": "docs_adr_0012_the_calculator_is_reached_by_invokeremote_costs", "label": "What invokeRemote costs", "file_type": "rationale", "source_file": "docs/adr/0012-the-calculator-is-reached-by-invokeremote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "baseUrl changes are major versions; verifier depends on Atlassian's JWKS; token life in seconds makes cold start a correctness concern."}, {"id": "docs_adr_0012_the_calculator_is_reached_by_invokeremote_rejected_bearer_secret_fetch", "label": "Rejected: bearer secret over plain fetch", "file_type": "rationale", "source_file": "docs/adr/0012-the-calculator-is-reached-by-invokeremote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nearly taken; ruled out because one URL cannot participate in per-install region pinning."}, {"id": "docs_adr_0012_the_calculator_is_reached_by_invokeremote_rejected_platform_without_zero", "label": "Rejected: hosting platforms without a real zero", "file_type": "rationale", "source_file": "docs/adr/0012-the-calculator-is-reached-by-invokeremote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App Runner and Fargate bill a floor while idle; rejected on the shape of the bill."}, {"id": "docs_adr_0012_the_calculator_is_reached_by_invokeremote_rejected_wsgi_adapter", "label": "Rejected: a WSGI adapter for a function runtime", "file_type": "rationale", "source_file": "docs/adr/0012-the-calculator-is-reached-by-invokeremote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lambda is cheapest but an adapter is a component that would have to be shown to compute nothing."}, {"id": "docs_adr_0012_the_calculator_is_reached_by_invokeremote_rejected_ip_allow_list", "label": "Rejected: an IP allow-list as access control", "file_type": "rationale", "source_file": "docs/adr/0012-the-calculator-is-reached-by-invokeremote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atlassian's egress ranges shift and carry every customer; a token proving from-Atlassian and minted-for-this-app is stronger."}], "edges": [{"source": "docs_adr_0012_the_calculator_is_reached_by_invokeremote_invokeremote", "target": "docs_adr_0012_the_calculator_is_reached_by_invokeremote", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0012-the-calculator-is-reached-by-invokeremote.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0012_the_calculator_is_reached_by_invokeremote_region_pinning", "target": "docs_adr_0012_the_calculator_is_reached_by_invokeremote", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0012-the-calculator-is-reached-by-invokeremote.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0012_the_calculator_is_reached_by_invokeremote_slice_route", "target": "docs_adr_0012_the_calculator_is_reached_by_invokeremote", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0012-the-calculator-is-reached-by-invokeremote.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0012_the_calculator_is_reached_by_invokeremote_costs", "target": "docs_adr_0012_the_calculator_is_reached_by_invokeremote", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0012-the-calculator-is-reached-by-invokeremote.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0012_the_calculator_is_reached_by_invokeremote_rejected_bearer_secret_fetch", "target": "docs_adr_0012_the_calcula