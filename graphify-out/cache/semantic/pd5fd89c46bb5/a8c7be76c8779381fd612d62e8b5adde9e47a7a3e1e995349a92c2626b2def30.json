{"nodes": [{"id": "docs_adr_0029_a_t_shirt_band_selects_a_reference_class", "label": "ADR 0029 A t-shirt band selects a reference class", "file_type": "document", "source_file": "docs/adr/0029-a-t-shirt-band-selects-a-reference-class.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0029_a_t_shirt_band_selects_a_reference_class_tshirt_band_is_a_selector", "label": "A t-shirt band selects a reference class", "file_type": "rationale", "source_file": "docs/adr/0029-a-t-shirt-band-selects-a-reference-class.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "S/M/L/XL are quartiles of the epics this board has completed, so 'L' means 'like this board's third-quartile epics' and differs per board. A band selects which observed delivery an ask is compared against; it asserts no number, so an optimist's mistake is visible rather than an invisible inflation."}, {"id": "docs_adr_0029_a_t_shirt_band_selects_a_reference_class_sizing_method_per_row", "label": "sizing_method / sizing_basis on every ordering row", "file_type": "rationale", "source_file": "docs/adr/0029-a-t-shirt-band-selects-a-reference-class.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Banded and unbanded asks share one comparison and the 'Sized by' column says which; all-or-nothing per board and sequencing only the sized asks were both rejected as silent narrowing."}, {"id": "docs_adr_0029_a_t_shirt_band_selects_a_reference_class_min_tshirt_epics", "label": "MIN_TSHIRT_EPICS = 8 (vs MIN_REFERENCE_EPICS 5)", "file_type": "concept", "source_file": "docs/adr/0029-a-t-shirt-band-selects-a-reference-class.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "History split four ways needs more observations; a board below it refuses in those words and the ask appears in skipped."}, {"id": "docs_adr_0029_a_t_shirt_band_selects_a_reference_class_size_field", "label": "orgConfig.sizeField", "file_type": "concept", "source_file": "docs/adr/0029-a-t-shirt-band-selects-a-reference-class.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Points at a site's own size field, recommended because Forge cannot declare a select."}], "edges": [{"source": "docs_adr_0029_a_t_shirt_band_selects_a_reference_class", "target": "docs_adr_0029_a_t_shirt_band_selects_a_reference_class_tshirt_band_is_a_selector", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0029-a-t-shirt-band-selects-a-reference-class.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0029_a_t_shirt_band_selects_a_reference_class", "target": "docs_adr_0029_a_t_shirt_band_selects_a_reference_class_sizing_method_per_row", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0029-a-t-shirt-band-selects-a-reference-class.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0029_a_t_shirt_band_selects_a_reference_class", "target": "docs_adr_0029_a_t_shirt_band_selects_a_reference_class_min_tshirt_epics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0029-a-t-shirt-band-selects-a-reference-class.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0029_a_t_shirt_band_selects_a_reference_class", "target": "docs_adr_0029_a_t_shirt_band_selects_a_reference_class_size_field", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0029-a-t-shirt-band-selects-a-reference-class.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0029_a_t_shirt_band_selects_a_reference_class", "target": "docs_adr_0006_forecast_in_items_not_points"