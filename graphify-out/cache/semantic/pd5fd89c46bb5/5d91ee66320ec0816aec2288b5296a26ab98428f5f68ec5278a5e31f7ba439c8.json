{"nodes": [{"id": "docs_adr_0016_the_image_takes_debians_security_updates_at_build_time", "label": "ADR 0016: The image takes Debian's security updates at build time", "file_type": "document", "source_file": "docs/adr/0016-the-image-takes-debians-security-updates-at-build-time.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0016_the_image_takes_debians_security_updates_at_build_time_apt_upgrade_at_build", "label": "The image applies Debian security updates at build time", "file_type": "rationale", "source_file": "docs/adr/0016-the-image-takes-debians-security-updates-at-build-time.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On 2026-08-28 the scan gate blocked every deploy on CVE-2026-14456 in OpenSSL (3 fixable findings). Rebuilding, pinning a newer digest and swapping base (3.13-slim, alpine, distroless) were all measured and all failed on the same CVE because no distribution had rebuilt for it. apt-get upgrade (never dist-upgrade) as the first layer: 3 fixable before, 0 after, image 52.6 to 56.5 MB."}, {"id": "docs_adr_0016_the_image_takes_debians_security_updates_at_build_time_scan_gate_actionability", "label": "Scan gate: fixable HIGH/CRITICAL block; unfixable are reported", "file_type": "rationale", "source_file": "docs/adr/0016-the-image-takes-debians-security-updates-at-build-time.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The line is actionability, not severity, because a gate that blocks on things no merge can fix is one people route around. Loosening the gate and suppressing via .trivyignore were refused: the first fixable finding waved through with a good reason is the point the gate becomes advisory. A red scan was twice misdescribed as unfixable findings by people who had not run service/scan.sh."}, {"id": "docs_adr_0016_the_image_takes_debians_security_updates_at_build_time_distroless_not_fewer_cves", "label": "Distroless is not a minimal CVE surface for Python", "file_type": "concept", "source_file": "docs/adr/0016-the-image-takes-debians-security-updates-at-build-time.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "distroless/python3-debian12 scanned at 46 HIGH/CRITICAL with 18 fixable; it answers 'ship no shell' not 'carry fewer CVEs'."}], "edges": [{"source": "docs_adr_0016_the_image_takes_debians_security_updates_at_build_time", "target": "docs_adr_0016_the_image_takes_debians_security_updates_at_build_time_apt_upgrade_at_build", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0016-the-image-takes-debians-security-updates-at-build-time.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0016_the_image_takes_debians_security_updates_at_build_time", "target": "docs_adr_0016_the_image_takes_debians_security_updates_at_build_time_scan_gate_actionability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0016-the-image-takes-debians-security-updates-at-build-time.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0016_the_image_takes_debians_security_updates_at_build_time", "target": "docs_adr_0016_the_image_takes_debians_security_updates_at_build_time_distroless_not_fewer_cves", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0016-the-image-takes-debians-security-updates-at-build-time.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0016_the_image_takes_debians_security_updates_at_build_time", "target": "docs_adr_0008_forge_calls_a_hosted_calculator", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0016-the-image-takes-debians-security-updates-at-build-time.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0016_the_image_takes_debians_security_updates_at_build_time_scan_gate_actionability", "target": "docs_adr_0016_the_image_takes_debians_security_updates_at_build_time_apt_upgrade_at_build", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0016-the-image-takes-debians-security-updates-at-build-time.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0016_the_image_takes_debians_security_updates_at_build_time", "target": "docs_hosting_the_calculator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0016-the-image-takes-debians-security-updates-at-build-time.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0016_the_image_takes_debians_security_updates_at_build_time_scan_gate_actionability", "target": "service_scan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0016-the-image-takes-debians-security-updates-at-build-time.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0016_the_image_takes_debians_security_updates_at_build_time_apt_upgrade_at_build", "target": "service_smoke", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0016-the-image-takes-debians-security-updates-at-build-time.md", "source_location": null, "weight": 1.0}], "hyperedges": []}