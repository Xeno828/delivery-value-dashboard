{"nodes": [{"id": "docs_adr_0001_single_self_contained_html_file", "label": "ADR 0001: The dashboard is one self-contained HTML file", "file_type": "document", "source_file": "docs/adr/0001-single-self-contained-html-file.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0001_single_self_contained_html_file_single_file_dashboard", "label": "Single self-contained HTML file", "file_type": "rationale", "source_file": "docs/adr/0001-single-self-contained-html-file.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Executives will not install anything and engineers will not trust a number they cannot open; a file with no build step, server, dependencies, network calls or storage satisfies both and survives being forwarded as an email attachment. The cost (no npm, hand-rolled SVG charts, committed dist/) was accepted because every dependency either phones home or fails to load once the file leaves the building."}, {"id": "docs_adr_0001_single_self_contained_html_file_emailed_file_threat_model", "label": "Threat model: the file gets emailed", "file_type": "rationale", "source_file": "docs/adr/0001-single-self-contained-html-file.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The file leaves the building; zero network and zero browser storage are enforced by the security suite so nothing in it can phone home or leak."}], "edges": [{"source": "docs_adr_0001_single_self_contained_html_file", "target": "docs_adr_0001_single_self_contained_html_file_single_file_dashboard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0001-single-self-contained-html-file.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0001_single_self_contained_html_file", "target": "docs_adr_0001_single_self_contained_html_file_emailed_file_threat_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0001-single-self-contained-html-file.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0001_single_self_contained_html_file_emailed_file_threat_model", "target": "docs_adr_0001_single_self_contained_html_file_single_file_dashboard", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0001-single-self-contained-html-file.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0001_single_self_contained_html_file", "target": "readme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0001-single-self-contained-html-file.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0001_single_self_contained_html_file", "target": "build", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0001-single-self-contained-html-file.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0001_single_self_contained_html_file", "target": "tests_security", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0001-single-self-contained-html-file.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0001_single_self_contained_html_file_emailed_file_threat_model", "target": "tests_security", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0001-single-self-contained-html-file.md", "source_location": null, "weight": 1.0}], "hyperedges": []}