{"nodes": [{"id": "docs_adr_0006_forecast_in_items_not_points", "label": "ADR 0006: Forecasts count items, never story points", "file_type": "document", "source_file": "docs/adr/0006-forecast-in-items-not-points.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0006_forecast_in_items_not_points_items_not_points", "label": "Forecasts count items, never story points", "file_type": "rationale", "source_file": "docs/adr/0006-forecast-in-items-not-points.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six sprints of points is six observations, which cannot support a distribution; the same sprints hold roughly sixty items. Item counting also cannot be inflated by estimating generously. Points remain a display toggle only."}, {"id": "docs_adr_0006_forecast_in_items_not_points_size_stability_check", "label": "size_stability(): the interchangeable-items assumption is checked", "file_type": "concept", "source_file": "docs/adr/0006-forecast-in-items-not-points.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Item forecasting assumes items are roughly interchangeable in size; that weakness is checked rather than trusted, looking for a team splitting work smaller and for cycle-time spread wide enough that counting loses meaning."}], "edges": [{"source": "docs_adr_0006_forecast_in_items_not_points", "target": "docs_adr_0006_forecast_in_items_not_points_items_not_points", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0006-forecast-in-items-not-points.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0006_forecast_in_items_not_points", "target": "docs_adr_0006_forecast_in_items_not_points_size_stability_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "s