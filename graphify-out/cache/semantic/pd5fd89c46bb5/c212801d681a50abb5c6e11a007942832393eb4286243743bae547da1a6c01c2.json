{"nodes": [{"id": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once", "label": "ADR 0030 The manifest commits to its hostnames and realms once", "file_type": "document", "source_file": "docs/adr/0030-the-manifest-commits-to-its-hostnames-and-realms-once.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once_run_app_hostnames_permanent", "label": "Calculator keeps its *.run.app hostnames permanently", "file_type": "rationale", "source_file": "docs/adr/0030-the-manifest-commits-to-its-hostnames-and-realms-once.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The real case for a custom domain was indirection (moving provider/region/project is a DNS change), and it collapsed because a project migrated into an organisation keeps its id and number, so hostnames only move if the project is recreated. A load balancer at $18-25/region/month is ten times the bill; Cloud Run domain mappings are preview and exclude europe-west3."}, {"id": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once_move_never_recreate_project", "label": "Rule: move the Google Cloud project, never recreate it", "file_type": "rationale", "source_file": "docs/adr/0030-the-manifest-commits-to-its-hostnames-and-realms-once.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leaving Google Cloud or recreating the project is a major version and a forced reinstall on every tenant; accepted with open eyes."}, {"id": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once_three_realms_us_eu_gb", "label": "Realms US, EU and GB with a London service", "file_type": "concept", "source_file": "docs/adr/0030-the-manifest-commits-to-its-hostnames-and-realms-once.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The UK is not inside EU (Frankfurt/Dublin); GB validated by forge lint passing GB and failing ZZ as a control. GB points at London, not Frankfurt, so the app never decides which region a tenant computes in."}, {"id": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once_undeclared_realm_behaviour_unknown", "label": "What a tenant pinned to an undeclared realm gets is unknown", "file_type": "concept", "source_file": "docs/adr/0030-the-manifest-commits-to-its-hostnames-and-realms-once.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Either a refused install (loud) or a silent fall-through to default (Iowa for a German customer). Question open with Atlassian; if silent, DE and CH are added before the first external install."}, {"id": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once_region_added_via_deploy_loop", "label": "A third region is a change to deploy.yml's region loop", "file_type": "rationale", "source_file": "docs/adr/0030-the-manifest-commits-to-its-hostnames-and-realms-once.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hand-deployed London service would stop receiving calculator versions on the next push with every check green \u2014 a stale service answering a customer, the plausible-wrong-number class."}], "edges": [{"source": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once", "target": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once_run_app_hostnames_permanent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0030-the-manifest-commits-to-its-hostnames-and-realms-once.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once", "target": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once_move_never_recreate_project", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0030-the-manifest-commits-to-its-hostnames-and-realms-once.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once", "target": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once_three_realms_us_eu_gb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0030-the-manifest-commits-to-its-hostnames-and-realms-once.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once", "target": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once_undeclared_realm_behaviour_unknown", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0030-the-manifest-commits-to-its-hostnames-and-realms-once.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once", "target": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once_region_added_via_deploy_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0030-the-manifest-commits-to-its-hostnames-and-realms-once.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once", "target": "docs_hosting_the_calculator", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0030-the-manifest-commits-to-its-hostnames-and-realms-once.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once_run_app_hostnames_permanent", "target": "docs_adr_0030_the_manifest_commits_to_its_hostnames_and_realms_once_move_never_recreate_project", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0030-the-manifest-commits-to-its-hostnames-and-realms-once.md", "source_location": null, "weight": 1.0}], "hyperedges": []}