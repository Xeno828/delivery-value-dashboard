{"nodes": [{"id": "docs_adr_0025_the_app_declares_a_business_value_field", "label": "ADR 0025 The app declares a Business Value field", "file_type": "document", "source_file": "docs/adr/0025-the-app-declares-a-business-value-field.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0025_the_app_declares_a_business_value_field_business_value_field", "label": "Business Value custom field (jira:customField)", "file_type": "concept", "source_file": "docs/adr/0025-the-app-declares-a-business-value-field.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declared in the manifest rather than created via REST (which needs Administer Jira); app never writes it; found by module key, not display name, because a site's own 'Business Value' field is not this one; unset is null, not 0."}, {"id": "docs_adr_0025_the_app_declares_a_business_value_field_value_from_hierarchy", "label": "orgConfig.valueFromHierarchy (default 1)", "file_type": "concept", "source_file": "docs/adr/0025-the-app-declares-a-business-value-field.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Value counted at epic level and above only: an epic worth \u00a340k with five \u00a38k stories is one value and six rows. A level rather than a type list so a site adding 'Initiative' keeps counting; issues with no recorded level still count."}, {"id": "docs_adr_0025_the_app_declares_a_business_value_field_value_tile_three_empty_states", "label": "Three empty states of the value tile", "file_type": "rationale", "source_file": "docs/adr/0025-the-app-declares-a-business-value-field.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing priced; nothing priced at the counted level; field not on a screen (the state every install is in on upgrade day). Each names its own fix."}, {"id": "docs_adr_0025_the_app_declares_a_business_value_field_major_vs_minor_version_rule", "label": "Major vs minor Forge version rule", "file_type": "rationale", "source_file": "docs/adr/0025-the-app-declares-a-business-value-field.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Correction: introducing a module type or changing a scope is major; adding an entry under an already-declared block is minor (ADR 0027's field deployed as 7.2.0 with no MAJOR_VERSION_RULE approval). Checked by deploying, not reasoning."}], "edges": [{"source": "docs_adr_0025_the_app_declares_a_business_value_field", "target": "docs_adr_0025_the_app_declares_a_business_value_field_business_value_field", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0025-the-app-declares-a-business-value-field.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0025_the_app_declares_a_business_value_field", "target": "docs_adr_0025_the_app_declares_a_business_value_field_value_from_hierarchy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0025-the-app-declares-a-business-value-field.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0025_the_app_declares_a_business_value_field", "target": "docs_adr_0025_the_app_declares_a_business_value_field_value_tile_three_empty_states", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0025-the-app-declares-a-business-value-field.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0025_the_app_declares_a_business_value_field", "target": "docs_adr_0025_the_app_declares_a_business_value_field_major_vs_minor_version_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0025-the-app-declares-a-bus