{"nodes": [{"id": "docs_adr_0005_tools_compute_the_agent_narrates", "label": "ADR 0005: The tools compute; the agent only narrates", "file_type": "document", "source_file": "docs/adr/0005-tools-compute-the-agent-narrates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0005_tools_compute_the_agent_narrates_tools_compute_agent_narrates", "label": "Tools compute; the agent narrates", "file_type": "rationale", "source_file": "docs/adr/0005-tools-compute-the-agent-narrates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every figure comes from metrics.py, forecast.py or intake.py and the agent quotes it, performing no arithmetic. When a number is wrong it is wrong in one Python file and fixed once; the moment the agent computes anything, no figure is auditable. The known liability is duplicated maths between tools and dashboard, made survivable by tests/test_agent.py."}], "edges": [{"source": "docs_adr_0005_tools_compute_the_agent_narrates", "target": "docs_adr_0005_tools_compute_the_agent_narrates_tools_compute_agent_narrates", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0005-tools-compute-the-agent-narrates.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0005_tools_compute_the_agent_narrates", "target": "agent_tools_metrics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0005-tools-compute-the-agent-narrates.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0005_tools_compute_the_agent_narrates", "target": "agent_tools_forecast", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0005-tools-compute-the-agent-narrates.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0005_tools_compute_the_agent_narrates