{"nodes": [{"id": "docs_adr_0031_the_forecast_runs_inside_the_forge_function", "label": "ADR 0031 The forecast runs inside the Forge function", "file_type": "document", "source_file": "docs/adr/0031-the-forecast-runs-inside-the-forge-function.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0031_the_forecast_runs_inside_the_forge_function_forecast_runs_inside_forge_function", "label": "The forecast runs inside the Forge function under Pyodide", "file_type": "rationale", "source_file": "docs/adr/0031-the-forecast-runs-inside-the-forge-function.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same Python unchanged under CPython-in-WebAssembly, byte-identical to native, nothing leaving Atlassian; the calculator is retired, the remotes block leaves, the app earns Runs on Atlassian and is PINNED by construction. Costs ~10x slower CPU, a 7 s cold load, and routes that no longer fit a synchronous call."}, {"id": "docs_adr_0031_the_forecast_runs_inside_the_forge_function_async_job_pattern", "label": "Async job: resolver pushes, consumer computes, adapter polls", "file_type": "concept", "source_file": "docs/adr/0031-the-forecast-runs-inside-the-forge-function.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolver validates/projects/pushes one async event; consumer runs the tools with a 900 s / 1024 MB budget; result waits in app storage; the bridge adapter polls and hands the page one {ok,status,body}, so src/app.js and ADR 0009's contract are untouched."}, {"id": "docs_adr_0031_the_forecast_runs_inside_the_forge_function_forecast_is_async_correction", "label": "Correction 2026-09-03: the forecast is asynchronous too", "file_type": "rationale", "source_file": "docs/adr/0031-the-forecast-runs-inside-the-forge-function.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On the dev board (906 mostly-zero observations, 31 open items) forecast_completion walks ~280 days per trial, 12-15 s in the resolver against a 15 s adapter clock; payload exceeds the 100 KB event limit so the projection travels via app storage in chunks under 240 KiB. Facts, history and burndown stay synchronous."}, {"id": "docs_adr_0031_the_forecast_runs_inside_the_forge_function_twelve_ask_cap", "label": "Sequencing cap: twelve asks, everywhere", "file_type": "concept", "source_file": "docs/adr/0031-the-forecast-runs-inside-the-forge-function.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sequencing is cubic in ask count (4 asks 1.1 s native / 11 s Forge; 16 asks 48 s / 479 s); the cap lives in the tool so both transports refuse in the same sentence. The old fifty was never run."}, {"id": "docs_adr_0031_the_forecast_runs_inside_the_forge_function_retry_guard", "label": "Consumer retry guard", "file_type": "concept", "source_file": "docs/adr/0031-the-forecast-runs-inside-the-forge-function.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A consumer killed at timeout is re-invoked every ~40 s for a day with retryReason FUNCTION_TIME_OUT; on any retry it writes a refusal and returns."}, {"id": "docs_adr_0031_the_forecast_runs_inside_the_forge_function_job_row", "label": "Job row in app storage", "file_type": "concept", "source_file": "docs/adr/0031-the-forecast-runs-inside-the-forge-function.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unguessable key, status started/done/refused, timestamp, asking account (poll refuses other accounts, so ADR 0018 mirroring holds by comparison); deleted on collection, one-hour TTL; in-flight jobs keyed by context, dataset and account so a reload joins rather than restarts."}, {"id": "docs_adr_0031_the_forecast_runs_inside_the_forge_function_runtime_travels_as_generated_module", "label": "Pyodide runtime travels as a base64 generated module", "file_type": "rationale", "source_file": "docs/adr/0031-the-forecast-runs-inside-the-forge-function.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forge's bundler breaks Pyodide's dynamic import, so runtime and Python sources are packed at deploy into a git-ignored module and unpacked to /tmp. The resolver function loads a memory snapshot (11 s to 1.3 s cold, 1.65x slower after); the consumer does not. Never committed: a second copy drifts."}, {"id": "docs_adr_0031_the_forecast_runs_inside_the_forge_function_routes_move_one_per_commit", "label": "Routes move one per commit, git is the switch", "file_type": "rationale", "source_file": "docs/adr/0031-the-forecast-runs-inside-the-forge-function.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each deploy has one change to blame; a runtime switch outliving the migration is an untested second code path. The remotes block is removed in its own final minor-version commit, at which point ADRs 0012 and 0030 are superseded."}, {"id": "docs_adr_0031_the_forecast_runs_inside_the_forge_function_wasm_parity_suite", "label": "WebAssembly parity suite (tests/test_wasm.py)", "file_type": "concept", "source_file": "docs/adr/0031-the-forecast-runs-inside-the-forge-function.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs the tools under Pyodide in local Node and asserts byte equality with native Python over the service fixtures; the successor of the hosted service's parity test."}], "edges": [{"source": "docs_adr_0031_the_forecast_runs_inside_the_forge_function", "target": "docs_adr_0031_the_forecast_runs_inside_the_forge_function_forecast_runs_inside_forge_function", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0031-the-forecast-runs-inside-the-forge-function.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0031_the_forecast_runs_inside_the_forge_function", "target": "docs_adr_0031_the_forecast_runs_inside_the_forge_function_async_job_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0031-the-forecast-runs-inside-the-forge-function.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0031_the_forecast_runs_inside_the_forge_function", "target": "docs_adr_0031_the_forecast_runs_inside_the_forge_function_forecast_is_async_correction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0031-the-forecast-runs-inside-the-forge-function.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0031_the_forecast_runs_inside_the_forge_function", "target": "docs_adr_0031_the_forecast_runs_inside_the_forge_function_twelve_ask_cap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0031-the-forecast-runs-inside-the-forge-function.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0031_the_forecast_runs_inside_the_forge_function", "target": "docs_adr_0031_the_forecast_runs_inside_the_forge_function_retry_guard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0031-the-forecast-runs-inside-the-forge-function.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0031_the_forecast_runs_inside_the_forge_function", "target": "docs_adr_0031_the_forecast_runs_inside_the_forge_function_job_row", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0031-the-forecast-runs-inside-the-forg