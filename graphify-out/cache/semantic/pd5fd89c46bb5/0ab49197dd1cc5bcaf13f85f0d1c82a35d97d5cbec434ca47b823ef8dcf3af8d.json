{"nodes": [{"id": "docs_connecting_jira_asana", "label": "Connecting Jira and Asana", "file_type": "document", "source_file": "docs/connecting-jira-asana.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_connecting_jira_asana_page_cannot_call_trackers", "label": "The page cannot call Jira or Asana itself", "file_type": "rationale", "source_file": "docs/connecting-jira-asana.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CORS rejects browser-origin requests and any token in an HTML file is readable by everyone it is forwarded to; live data arrives via a script running where credentials already live, making the credential boundary explicit."}, {"id": "docs_connecting_jira_asana_oauth_3lo_route", "label": "OAuth 2.0 (3LO) route via scripts/jira_auth.py", "file_type": "concept", "source_file": "docs/connecting-jira-asana.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only scopes read:jira-work and read:jira-user, callback on 127.0.0.1:8721, grant stored in .jira-oauth.json mode 0600 and git-ignored; a grant covering several sites makes the fetcher refuse to guess. --auth auto prefers the grant and prints which was used."}, {"id": "docs_connecting_jira_asana_fetcher_api_token_route", "label": "Fetcher with an API token (scripts/fetch_delivery_data.py)", "file_type": "concept", "source_file": "docs/connecting-jira-asana.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Right for your own board, wrong for a customer's: the token carries its owner's permissions, cannot be scoped, and is revoked only by deletion. Carries previous values forward and prints what was missing."}, {"id": "docs_connecting_jira_asana_mcp_and_csv_routes", "label": "MCP connectors and CSV export routes", "file_type": "concept", "source_file": "docs/connecting-jira-asana.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude holds the MCP connection, not the page; CSV export is the right starting point to prove which metrics people use before building a pipeline."}], "edges": [{"source": "docs_connecting_jira_asana", "target": "docs_connecting_jira_asana_page_cannot_call_trackers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/connecting-jira-asana.md", "source_location": null, "weight": 1.0}, {"source": "docs_connecting_jira_asana", "target": "docs_connecting_jira_asana_oauth_3lo_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/connecting-jira-asana.md", "source_location": null, "weight": 1.0}, {"source": "docs_connecting_jira_asana", "target": "docs_connecting_jira_asana_fetcher_api_token_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/connecting-jira-asana.md", "source_location": null, "weight": 1.0}, {"source": "docs_connecting_jira_asana", "target": "docs_connecting_jira_asana_mcp_and_csv_routes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/connecting-jira-asana.md", "source_location": null, "weight": 1.0}, {"source": "docs_connecting_jira_asana_oauth_3lo_route", "target": "scripts_jira_auth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/connecting-jira-asana.md", "source_location": null, "weight": 1.0}, {"source": "docs_connecting_jira_asana_fetcher_api_token_route", "target": "scripts_fetch_delivery_data", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/connecting-jira-asana.md", "source_location": null, "weight": 1.0}, {"source": "docs_connecting_jira_asana_page_ca