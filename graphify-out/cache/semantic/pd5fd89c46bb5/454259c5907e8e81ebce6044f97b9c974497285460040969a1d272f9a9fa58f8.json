{"nodes": [{"id": "docs_adr_0018_permission_mirroring_holds_by_accident_and_where_it_does_not", "label": "ADR 0018: Permission mirroring holds by accident, and here is where it does not", "file_type": "document", "source_file": "docs/adr/0018-permission-mirroring-holds-by-accident-and-where-it-does-not.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0018_permission_mirroring_holds_by_accident_and_where_it_does_not_permission_mirroring_by_asuser", "label": "Permission mirroring holds for free because every panel read is asUser()", "file_type": "rationale", "source_file": "docs/adr/0018-permission-mirroring-holds-by-accident-and-where-it-does-not.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jira decides what comes back, so no figure was computed over an issue the viewer cannot browse. Not a mechanism this product built; it costs nothing as long as nothing is kept \u2014 and item 4a converted that property into an assumption."}, {"id": "docs_adr_0018_permission_mirroring_holds_by_accident_and_where_it_does_not_three_exposures", "label": "The three places mirroring does not hold", "file_type": "concept", "source_file": "docs/adr/0018-permission-mirroring-holds-by-accident-and-where-it-does-not.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1) the durable series stores rows fetched as one viewer and shows them to everyone; 2) the forecast log has the same shape; 3) the brief tells recipients aggregates over issues they may not browse (restrict is anchor-only). All three leak counts, never identity."}, {"id": "docs_adr_0018_permission_mirroring_holds_by_accident_and_where_it_does_not_app_store_inventory", "label": "Every app-level store is declared in tests/test_service.py with its authority", "file_type": "rationale", "source_file": "docs/adr/0018-permission-mirroring-holds-by-accident-and-where-it-does-not.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The exposure is an inventory, not a hunt \u2014 the same shape as the non-read scope allow-list, so a fourth store cannot appear silently."}, {"id": "docs_adr_0018_permission_mirroring_holds_by_accident_and_where_it_does_not_brief_is_only_figures", "label": "The brief's prompt is a list of numbers, not titles", "file_type": "concept", "source_file": "docs/adr/0018-permission-mirroring-holds-by-accident-and-where-it-does-not.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every section in sectionsFor is counts, dates and units and briefMessages hands the model only those; the roadmap and ADR 0013 overstate what the model is given."}], "edges": [{"source": "docs_adr_0018_permission_mirroring_holds_by_accident_and_where_it_does_not", "target": "docs_adr_0018_permission_mirroring_holds_by_accident_and_where_it_does_not_permission_mirroring_by_asuser", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0018-permission-mirroring-holds-by-accident-and-where-it-does-not.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0018_permission_mirroring_holds_by_accident_and_where_it_does_not", "target": "docs_adr_0018_permission_mirroring_holds_by_accident_and_where_it_does_not_three_exposures", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0018-permission-mirroring-holds-by-accident-and-where-it-does-not.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0018_permission_mirroring_holds_by_accident_and_where_it_does_not", "target": "docs_adr_0018_permission_mirroring_holds_by_accident_and_where_it_does_not_app_store_inventory", "relation": "references", "confidence": "EXTRACTED", "confid