{"nodes": [{"id": "docs_adr_0021_the_audit_log_is_operational_and_says_so", "label": "ADR 0021: The audit log is operational, and says so", "file_type": "document", "source_file": "docs/adr/0021-the-audit-log-is-operational-and-says-so.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0021_the_audit_log_is_operational_and_says_so_operational_activity_log", "label": "Build the operational log; say plainly it is not a compliance record", "file_type": "rationale", "source_file": "docs/adr/0021-the-audit-log-is-operational-and-says-so.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most of an audit log never depended on item 5: recipient changes and brief sends are acts of this app under an authority already enforced. Jira accepts no audit record from an app and reading Jira's own log needs Administer Jira. forge/src/audit.js holds four events (recipients.saved, recipients.cleared, brief.sent, brief.refused) in app storage; the tile and auditNote say it is not tamper-evident and tests assert they still do."}, {"id": "docs_adr_0021_the_audit_log_is_operational_and_says_so_not_tamper_evident", "label": "An app writing its own rewritable log is not tamper-evident", "file_type": "rationale", "source_file": "docs/adr/0021-the-audit-log-is-operational-and-says-so.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A tile presenting it as an audit trail would be the most convincing wrong thing in the product; the route that answers a security review is emitting events to the customer's own sink, a bigger crossing than ADR 0013 and a separate record. The word 'audit' without qualification is ruled out everywhere."}, {"id": "docs_adr_0021_the_audit_log_is_operational_and_says_so_visible_bound_dropped_total", "label": "The bound is cumulative and visible: droppedTotal lives in the store", "file_type": "rationale", "source_file": "docs/adr/0021-the-audit-log-is-operational-and-says-so.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A reader arriving after the ten-thousandth event is told nine thousand rows are gone; an audit log that silently forgets is worse than none because the absence of a row reads as the absence of the event."}, {"id": "docs_adr_0021_the_audit_log_is_operational_and_says_so_audit_entry_allow_list", "label": "problemsInAuditEntry: counts, flags, field names, one actor identity", "file_type": "concept", "source_file": "docs/adr/0021-the-audit-log-is-operational-and-says-so.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The actor is unavoidable; a recipient's account id cannot reach a store that grows without bound. Writing never fails the act it records. Administrators only, gated by canEdit."}], "edges": [{"source": "docs_adr_0021_the_audit_log_is_operational_and_says_so", "target": "docs_adr_0021_the_audit_log_is_operational_and_says_so_operational_activity_log", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0021-the-audit-log-is-operational-and-says-so.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0021_the_audit_log_is_operational_and_says_so", "target": "docs_adr_0021_the_audit_log_is_operational_and_says_so_not_tamper_evident", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0021-the-audit-log-is-operational-and-says-so.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0021_the_audit_log_is_operational_and_says_so", "target": "docs_adr_0021_the_audit_log_is_operational_and_says_so_visible_bound_dropped_total", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs