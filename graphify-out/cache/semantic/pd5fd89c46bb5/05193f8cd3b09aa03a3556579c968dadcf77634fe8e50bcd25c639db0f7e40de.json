{"nodes": [{"id": "docs_contexts_and_live_mode", "label": "Filtering by project, board and sprint (contexts and live mode)", "file_type": "document", "source_file": "docs/contexts-and-live-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contexts_and_live_mode_context", "label": "Context: one project + board + sprint", "file_type": "concept", "source_file": "docs/contexts-and-live-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bundle is a list of contexts plus their issues; pickers cascade project to board to sprint; each board offers an All N sprints roll-up where burndown and releases refuse."}, {"id": "docs_contexts_and_live_mode_bundle_schema_v2", "label": "Bundle format (schemaVersion 2.0)", "file_type": "concept", "source_file": "docs/contexts-and-live-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Additive to v1.0; contexts[], defaultContextId, issues[].contextId, byContext[id] with burndown/history/releases/dora. Each context's history contains only sprints up to and including itself so a past report does not leak the future."}, {"id": "docs_contexts_and_live_mode_live_mode", "label": "Live mode via scripts/serve_live.py", "file_type": "concept", "source_file": "docs/contexts-and-live-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Page probes api/contexts on load (skipped on file://); stubs fetched on selection only; server binds 127.0.0.1 and holds credentials in memory; the server's orgConfig wins because it computed the forecasts."}, {"id": "docs_contexts_and_live_mode_api_forecast_route", "label": "GET api/forecast?id=", "file_type": "concept", "source_file": "docs/contexts-and-live-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full forecast.py output plus sampled_from; items/date overrides echoed under asked and rejected with 400 rather than dropped; samples the whole team across all its sprints with remaining from the selected context; 400-working-day horizon reported as unfinished_fraction; calendar named in inputs.calendar."}, {"id": "docs_contexts_and_live_mode_api_sequence_route", "label": "GET api/sequence?id=", "file_type": "concept", "source_file": "docs/contexts-and-live-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs intake.sequence() over data/asks/ for the board; bundle backend only, live Jira returns available: false because a sprint-at-a-time pull lacks completed epics and interruption rate. No value score is computed."}, {"id": "docs_contexts_and_live_mode_performance_flat_in_dataset_size", "label": "Interaction cost is flat in dataset size", "file_type": "concept", "source_file": "docs/contexts-and-live-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured by tests/perf.py: switching sprint ~23-39 ms from 22 to 5,538 issues; the ceiling is payload (2.8 MB at 66 boards), not rendering; scoping the sprint dropdown saves 0.0 ms."}], "edges": [{"source": "docs_contexts_and_live_mode", "target": "docs_contexts_and_live_mode_context", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/contexts-and-live-mode.md", "source_location": null, "weight": 1.0}, {"source": "docs_contexts_and_live_mode", "target": "docs_contexts_and_live_mode_bundle_schema_v2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/contexts-and-live-mode.md", "source_location": null, "weight": 1.0}, {"source": "docs_contexts_and_live_mode", "target": "docs_contexts_and_live_mode_live_m