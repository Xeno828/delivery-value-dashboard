      },
      {
        "name": "toast",
        "value": "opacity .18s, transform .18s",
        "purpose": "Toast rising 12px into place."
      },
      {
        "name": "reduced-motion",
        "value": "@media (prefers-reduced-motion: reduce) { * { transition: none !important } }",
        "purpose": "Every transition is removed when the reader asks."
      }
    ],
