      "css": ".ds-icon-btn{font:12px system-ui,-apple-system,'Segoe UI',sans-serif;border:1px solid var(--border,rgba(11,11,11,.10));background:var(--surface-1,#fcfcfb);border-radius:7px;width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;color:var(--text-secondary,#52514e);padding:0;cursor:pointer}.ds-icon-btn:hover{background:var(--plane,#f3f3f0);color:var(--text-primary,#0b0b0b)}.ds-icon-btn[aria-pressed=true]{background:var(--info-wash,#eaf1fc);border-color:var(--link,#256abf);color:var(--link,#256abf)}.ds-icon-btn:focus-visible{outline:2px solid var(--link,#256abf);outline-offset:2px}"
    },
    {
      "name": "Segmented Toggle",
