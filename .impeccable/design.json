    "typographyMeta": {
      "display": {
        "displayName": "Display",
        "purpose": "The value hero figure only; one per page."
      },
      "headline": {
        "displayName": "Headline",
        "purpose": "The eight KPI values and, at 20px, the page title."
      },
      "title": {
        "displayName": "Title",
        "purpose": "Card headings phrased as questions; panel and modal titles step to 16 and 17px."
      },
      "body": {
        "displayName": "Body",
        "purpose": "Verdict paragraph, findings, issue summaries."
      },
      "caption": {
        "displayName": "Caption",
        "purpose": "Card captions, the why under a finding, control text, the forecast basis in italic."
      },
      "label": {
        "displayName": "Label",
        "purpose": "Uppercase tracked labels beside filters and in table headers."
      },
      "mono": {
        "displayName": "Mono",
        "purpose": "Account ids, pasted JSON and code only."
      },
      "scale": {
        "displayName": "Scale",
        "purpose": "The enumerated ramp: every size the page sets, named for where it is used. The roles above are the ones a new element should reach for first."
      }
    },
