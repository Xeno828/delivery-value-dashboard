  "components": [
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "The default action: paper, hairline, ink. Hover fills with the plane.",
      "html": "<button class=\"ds-btn ds-btn-secondary\">Export CSV</button>",
      "css": ".ds-btn{font:550 12.5px/1.5 system-ui,-apple-system,'Segoe UI',sans-serif;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;border:1px solid var(--border,rgba(11,11,11,.10));border-radius:8px;padding:7px 12px;cursor:pointer}.ds-btn-secondary{background:var(--surface-1,#fcfcfb);color:var(--text-primary,#0b0b0b)}.ds-btn-secondary:hover{background:var(--plane,#f3f3f0)}.ds-btn-secondary:focus-visible{outline:2px solid var(--link,#256abf);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "One per surface. Accent blue fill, white text, brightens on hover.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Load data</button>",
      "css": ".ds-btn{font:550 12.5px/1.5 system-ui,-apple-system,'Segoe UI',sans-serif;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;border:1px solid var(--border,rgba(11,11,11,.10));border-radius:8px;padding:7px 12px;cursor:pointer}.ds-btn-primary{background:var(--accent-bg,#256abf);border-color:var(--accent-bg,#256abf);color:var(--on-accent,#fff)}.ds-btn-primary:hover{filter:brightness(1.08)}.ds-btn-primary:focus-visible{outline:2px solid var(--link,#256abf);outline-offset:2px}"
    },
