      "html": "<button class=\"ds-kpi\"><span class=\"ds-k-lab\">Delivered</span><span class=\"ds-k-val\">55%</span><span class=\"ds-k-sub\">12 of 22 items &middot; 41 pts</span><span class=\"ds-k-delta\">&#9650; +63% vs last sprint</span><span class=\"ds-k-bar\"><i style=\"width:55%;background:var(--s1,#2a78d6)\"></i></span></button>",
      "css": ".ds-kpi{font-family:system-ui,-apple-system,'Segoe UI',sans-serif;text-align:left;width:200px;background:var(--surface-1,#fcfcfb);border:1px solid var(--border,rgba(11,11,11,.10));border-radius:12px;padding:11px 13px 12px;box-shadow:0 1px 2px rgba(11,11,11,.05),0 6px 18px rgba(11,11,11,.05);cursor:pointer;color:var(--text-primary,#0b0b0b);transition:transform .08s ease,box-shadow .12s ease;display:block}.ds-kpi:hover{transform:translateY(-1px);box-shadow:0 2px 4px rgba(11,11,11,.06),0 10px 24px rgba(11,11,11,.09)}.ds-kpi:focus-visible{outline:2px solid var(--link,#256abf);outline-offset:2px}.ds-k-lab{font-size:11.5px;color:var(--text-secondary,#52514e);font-weight:600;display:block}.ds-k-val{display:block;font-size:27px;font-weight:640;letter-spacing:-.02em;margin:3px 0 1px;line-height:1.05;font-variant-numeric:tabular-nums}.ds-k-sub{display:block;font-size:11.5px;color:var(--muted,#6f6d67);min-height:16px}.ds-k-delta{margin-top:2px;font-size:11.5px;font-weight:600;color:var(--good-ink,#006300);display:inline-flex;gap:3px}.ds-k-bar{display:block;height:3px;border-radius:2px;background:var(--grid,#e1e0d9);margin-top:8px;overflow:hidden}.ds-k-bar>i{display:block;height:100%;border-radius:2px}"
    },
    {
