# Copy to .env and fill in. .env is git-ignored — keep it that way.

# --- Jira ---
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_TOKEN=
JIRA_BOARD=42

# --- Asana (optional) ---
ASANA_TOKEN=
ASANA_PROJECT=

# --- header text ---
ORG_NAME=Your Company
TEAM_NAME=Your Team
