# Copy to .env and fill in. .env is git-ignored — keep it that way.

# --- Jira, personal API token (your own board, no app registration) ---
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_TOKEN=
JIRA_BOARD=42

# --- Jira, OAuth 2.0 3LO (a customer's site) ---
# From developer.atlassian.com > Console > OAuth 2.0 integration.
# The grant itself lands in .jira-oauth.json, not here.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
# Only needed when one grant covers more than one site.
JIRA_SITE=

# --- Asana (optional) ---
ASANA_TOKEN=
ASANA_PROJECT=

# --- header text ---
ORG_NAME=Your Company
TEAM_NAME=Your Team
