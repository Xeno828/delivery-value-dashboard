# credentials — never commit these
.env
*.pem
*.token
# the OAuth grant: an access token and a rotating refresh token, mode 0600
.jira-oauth.json

# generated data pulled from Jira/Asana (contains issue titles)
data/dashboard-data.json
data/*.local.json

# python
__pycache__/
*.pyc
.venv/
venv/

# node. The dashboard itself still has no JavaScript dependencies — that is
# asserted against the root package.json on every push.
node_modules/
package-lock.json
# ...but the Forge app has two, and it runs inside a customer's Jira tenant.
# The rule above was written when nothing shipped npm packages; that reasoning
# does not cover a deployed app, so its lockfile is kept.
!forge/package-lock.json

# generated by `make report` — written, never read back; only scope.json is an input
agent/snapshots/facts-latest.json

# staged by `make forge-static` — a copy of dist/, which is already committed.
# Committing it twice is two things that can go stale instead of one.
forge/static/

# written into forge/manifest.yml by `forge register`. Having one locally is
# correct; committing it points every clone at one developer's app.
# tests/test_service.py fails the build if it reaches HEAD.

# test output
tests/last-run.png
tests/*.tmp.*

# os
.DS_Store
Thumbs.db

# dev screenshots regenerated by tests/shots.py
tests/wiz-*.png
