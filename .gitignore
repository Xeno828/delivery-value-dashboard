# credentials — never commit these
.env
*.pem
*.token
# the OAuth grant: an access token and a rotating refresh token, mode 0600
.jira-oauth.json

# generated data pulled from Jira/Asana (contains issue titles)
data/dashboard-data.json
data/*.local.json

# python
__pycache__/
*.pyc
.venv/
venv/

# node. The dashboard itself still has no JavaScript dependencies — that is
# asserted against the root package.json on every push.
node_modules/
package-lock.json
# ...but the Forge app has two, and it runs inside a customer's Jira tenant.
# The rule above was written when nothing shipped npm packages; that reasoning
# does not cover a deployed app, so its lockfile is kept.
!forge/package-lock.json

# generated by `make report` — written, never read back; only scope.json is an input
agent/snapshots/facts-latest.json

# staged by `make forge-static` — a copy of dist/, which is already committed.
# Committing it twice is two things that can go stale instead of one.
forge/static/

# generated by `make forge-assets`: the Python runtime, agent/tools/ and
# service/routes.py, gzip-and-base64, plus a memory snapshot, for the Forge
# function to unpack. Seventeen megabytes, and a second copy of the Python —
# and a second copy drifts. Built at deploy from the sources this repository
# already commits. ADR 0031; the security suite asserts this line.
forge/src/assets.js

# written into forge/manifest.yml by `forge register`. Having one locally is
# correct; committing it points every clone at one developer's app.
# tests/test_service.py fails the build if it reaches HEAD.

# test output
tests/last-run.png
tests/*.tmp.*

# os
.DS_Store
Thumbs.db

# dev screenshots regenerated by tests/shots.py
tests/wiz-*.png

# Written and removed by tests/e2e.py's transport section. It has to live under
# dist/ because that is where the live-mode endpoints are routed from; named
# here so a crashed run cannot leave it looking like a committed artefact.
dist/.transport-test.html

# Written by the retired calculator's provisioning script: a project id, two
# service account emails and a federation path. Not secret, but one person's,
# and the values the cloud teardown in CHANGELOG 1.78.0 needs — so it stays
# ignored until Google Cloud project calculator-506614 is emptied, then goes.
.gcp-deploy.env
